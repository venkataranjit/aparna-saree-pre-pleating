{
  "name": "aparna-saree-pre-pleating",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --mode dev",
    "dev:prod": "vite --mode prod",
    "build": "vite build --mode dev",
    "build:dev": "vite build --mode dev",
    "build:prod": "vite build --mode prod",
    "preview": "vite preview",
    "build:apk": "node scripts/build-apk.mjs --mode dev",
    "build:apk:dev": "node scripts/build-apk.mjs --mode dev",
    "build:apk:prod": "node scripts/build-apk.mjs --mode prod",
    "cap:sync": "cap sync android",
    "cap:sync:dev": "node -e \"const fs=require('fs');fs.copyFileSync('android/app/src/dev/google-services.json','android/app/google-services.json');console.log('Active: DEV google-services.json');\" && cap sync android",
    "cap:sync:prod": "node -e \"const fs=require('fs');fs.copyFileSync('android/app/src/prod/google-services.json','android/app/google-services.json');console.log('Active: PROD google-services.json');\" && cap sync android",
    "cap:open": "cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/cli": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/filesystem": "^7.0.0",
    "@capacitor/share": "^7.0.0",
    "@capgo/capacitor-social-login": "^7.20.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "^7.3.11",
    "@mui/material": "^7.3.11",
    "firebase": "^12.18.0",
    "formik": "^2.4.9",
    "html2pdf.js": "^0.14.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.18.3",
    "react-toastify": "^11.1.0",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "puppeteer": "^25.10.0",
    "sass": "^1.85.0",
    "vite": "^6.2.0"
  }
}
